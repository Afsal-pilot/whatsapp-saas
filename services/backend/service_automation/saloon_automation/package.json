{
  "name": "@whatsapp-saas/automation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,md}\"",
    "check:config": "tsx scripts/check-config.ts",
    "deploy": "bash scripts/deploy.sh",
    "smoke": "tsx scripts/smoke-test.ts",
    "backfill:tenant-phone": "tsx scripts/backfill-tenant-phone.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@sentry/nextjs": "^8.40.0",
    "@supabase/supabase-js": "^2.45.0",
    "@upstash/qstash": "^2.7.0",
    "@whatsapp-saas/wapi-db": "workspace:*",
    "@whatsapp-saas/wapi-meta": "workspace:*",
    "next": "14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.18",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
